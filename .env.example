# Copy to .env and fill in. Never commit .env.
OPENAI_BASE_URL=https://example.invalid/v1
OPENAI_API_KEY=sk-replace-me

# Model id exposed by the endpoint (see GET /v1/models)
CAIR_MODEL=Qwen3.6-35B-A3B

# Data
CAIR_DATA_DIR=./data_subset10
CAIR_INDEX_PATH=./runs/case_index.json
CAIR_SQLITE_PATH=./runs/cair.sqlite

# Backend: file | sqlite
CAIR_BACKEND=file
# findings.md visibility to the agent: hidden | visible
CAIR_FINDINGS_POLICY=hidden

# Per-case budgets
CAIR_MAX_TOOL_CALLS=14
CAIR_MAX_IMAGES=24
CAIR_LLM_TIMEOUT_S=120
CAIR_CASE_TIMEOUT_S=900
